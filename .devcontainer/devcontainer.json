{
  "name": "Kippy integration",
  "build": {"dockerfile": "Dockerfile"},
  "postCreateCommand": "./script/setup",
  "forwardPorts": [8123],
  "portsAttributes": {"8123": {"label": "Home Assistant"}},
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python", "redhat.vscode-yaml"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv-dev/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {"editor.defaultFormatter": "charliermarsh.ruff"}
      }
    }
  }
}
