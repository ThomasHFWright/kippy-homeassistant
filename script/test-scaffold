#!/usr/bin/env python3
"""Check development configuration and signal forwarding without starting HA."""

import os
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def main() -> None:
    """Run the development launcher against a tiny stand-in for Home Assistant."""
    root = Path(__file__).resolve().parent.parent
    with tempfile.TemporaryDirectory(prefix=".scaffold-check-", dir=root) as temp:
        directory = Path(temp)
        venv = directory / "venv"
        (venv / "bin").mkdir(parents=True)
        python = venv / "bin/python"
        python.write_text(
            f"#!{sys.executable}\n"
            "import os, signal, sys\n"
            "from pathlib import Path\n"
            "if sys.argv[1:3] == ['-m', 'homeassistant']:\n"
            "    assert '--skip-pip-packages' in sys.argv\n"
            "    assert 'kippy-api' in sys.argv\n"
            "    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))\n"
            "    Path(os.environ['READY']).write_text(str(os.getpid()))\n"
            "    signal.pause()\n"
            "else:\n"
            f"    os.execv({sys.executable!r}, [{sys.executable!r}, *sys.argv[1:]])\n"
        )
        python.chmod(0o755)
        ready = directory / "ready"
        config = directory / "config"
        env = dict(
            os.environ,
            KIPPY_VENV=str(venv),
            KIPPY_DEV_CONFIG=str(config),
            KIPPY_DEV_PORT="18123",
            READY=str(ready),
        )
        process = subprocess.Popen(["bash", str(root / "script/develop")], env=env)
        try:
            deadline = time.monotonic() + 10
            while not ready.exists() and time.monotonic() < deadline:
                assert process.poll() is None, "Launcher exited before starting HA"
                time.sleep(0.01)
            assert ready.exists(), "Launcher did not start HA"
            assert int(ready.read_text()) == process.pid, "HA must replace the shell"
            assert (config / "custom_components/kippy").resolve() == (
                root / "custom_components/kippy"
            )
            assert (
                "server_host: 127.0.0.1" in (config / "configuration.yaml").read_text()
            )
            process.send_signal(signal.SIGTERM)
            assert process.wait(timeout=5) == 0
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
        invalid = subprocess.run(
            ["bash", str(root / "script/develop")],
            env={**env, "KIPPY_DEV_PORT": "65536"},
            capture_output=True,
            check=False,
        )
        assert invalid.returncode != 0, "Invalid port must be rejected"
    print("Development launcher configuration and shutdown checks passed")


if __name__ == "__main__":
    main()
