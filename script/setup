#!/usr/bin/env bash
# Install development dependencies; KIPPY_API_PATH enables a local library checkout.
set -euo pipefail
cd "$(dirname "$0")/.."
venv="${KIPPY_VENV:-$PWD/.venv-dev}"
python="${KIPPY_PYTHON:-python3.14}"
if [[ ! -x "$venv/bin/python" ]]; then
  "$python" -m venv "$venv"
fi
"$venv/bin/python" -c 'import sys; assert sys.version_info >= (3, 14, 2), "Development requires Python >=3.14.2"'
"$venv/bin/python" -m pip install -r requirements-dev.txt
if [[ -n "${KIPPY_API_PATH:-}" ]]; then
  "$venv/bin/python" -m pip install -e "$KIPPY_API_PATH"
fi
# Install manifest requirements, preserving an intentionally editable API checkout.
"$venv/bin/python" - <<'PYCODE'
import json
import os
import subprocess
import sys
from pathlib import Path
requirements = json.loads(Path("custom_components/kippy/manifest.json").read_text())["requirements"]
if os.environ.get("KIPPY_API_PATH"):
    requirements = [item for item in requirements if not item.startswith("kippy-api==")]
if requirements:
    subprocess.run([sys.executable, "-m", "pip", "install", *requirements], check=True)
PYCODE
printf 'Setup complete. Run script/test or script/develop.\n'
